# ─────────────────────────────────────────────────────────────────────────────
#  Sprice Private — переменные окружения
#  Скопируй в .env для локальной разработки:  cp .env.example .env
#  На Render эти же переменные задаются в разделе Environment.
#  ВАЖНО: .env в репозиторий не коммитится (он в .gitignore).
# ─────────────────────────────────────────────────────────────────────────────

# ─── Сервер ───
# На Render PORT задаётся автоматически, вручную не трогать.
PORT=3000
# production включает secure-cookie и HSTS. Локально оставь пустым.
NODE_ENV=

# ─── База данных ───
# Если DATABASE_URL задан — используется Postgres, иначе встроенный SQLite (только локально).
# На Render: создай PostgreSQL и скопируй сюда Internal Database URL.
# Файловая система Render эфемерная — без Postgres данные будут теряться при каждом деплое.
DATABASE_URL=
# Локальный файл SQLite (используется только когда DATABASE_URL пуст)
SQLITE_PATH=./data/sprice.db
# Отключить SSL для Postgres (по умолчанию включается сам для не-localhost)
PGSSL=
PG_POOL_MAX=5

# ─── Секреты ───
# ОБЯЗАТЕЛЬНО смени в продакшене! Иначе коды подтверждения можно подделать.
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CODE_PEPPER=change-me-please-32-random-bytes

# ─── Почта (выбери ОДИН вариант) ───
# ВАЖНО ПРО ХОСТИНГ: бесплатный план Render блокирует исходящий SMTP на портах
# 25, 465 и 587. Там вариант 2 не заработает никогда — приходит ETIMEDOUT, хотя
# логин и пароль верные. На Render нужен вариант 1 (Resend, отправка по HTTPS:443).
#   https://render.com/changelog/free-web-services-will-no-longer-allow-outbound-traffic-to-smtp-ports
#
# Вариант 1 — Resend (проще всего, 3000 писем/мес бесплатно).
#   Домен ОБЯЗАТЕЛЕН: Resend отправляет только с подтверждённого домена, тестового
#   отправителя onboarding@resend.dev для реальной отправки больше нет.
#     1. resend.com → Domains → Add Domain → свой домен
#     2. перенести показанные TXT/MX-записи в DNS хостинг домена
#        (в Cloudflare у CNAME обязательно выключить прокси — серое облако)
#     3. дождаться Verified, затем API Keys → Create API Key
#   MAIL_FROM (см. ниже) обязан быть на подтверждённом домене, иначе письмо отклонят.
RESEND_API_KEY=

# Вариант 2 — Gmail.
#   ВАЖНО: обычный пароль от Google-аккаунта SMTP НЕ принимает — Google ответит
#   «535 Username and Password not accepted». Нужен ПАРОЛЬ ПРИЛОЖЕНИЯ:
#     1. включи двухэтапную аутентификацию: https://myaccount.google.com/security
#     2. создай пароль приложения:           https://myaccount.google.com/apppasswords
#        (если страница говорит «Настройка недоступна» — 2FA включилась только что,
#         подожди пару минут и обнови)
#     3. скопируй 16 символов. Google показывает их группами по 4 («abcd efgh ijkl mnop»);
#        пробелы можно оставить — их уберёт и src/mail.js, и npm run mail:set-pass.
#   Записать пароль, не открывая этот файл:  npm run mail:set-pass -- "abcd efgh ijkl mnop"
#   Проверить, что всё верно, не запуская сайт:  npm run mail:check
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=name@gmail.com
SMTP_PASS=

# Вариант 3 — Brevo / Mailgun / Яндекс 360 / свой сервер: любой SMTP.
#   Обычно порт 587 и SMTP_SECURE=false (STARTTLS).

# Если не задано ничего — включается DEV-режим:
# письма не уходят, код подтверждения печатается в логах сервера.

# Адрес отправителя. Пусто → подставится SMTP_USER (для Gmail это то, что нужно).
# Для Resend задавать ОБЯЗАТЕЛЬНО и только адресом на подтверждённом домене,
# иначе Resend отклонит письмо: Sprice Private <noreply@твой-домен>
MAIL_FROM=
MAIL_REPLY_TO=
# Адрес сайта — подставляется в письмо и в ссылки
SITE_URL=http://localhost:3000

# ─── Поведение кодов и сессий ───
CODE_TTL_MINUTES=10
CODE_MAX_ATTEMPTS=5
RESEND_COOLDOWN_SEC=60
RESEND_MAX_PER_HOUR=5

# «Запомнить меня» — 30 дней; без галочки — 12 часов
SESSION_TTL_HOURS=720
SESSION_TTL_HOURS_SHORT=12
# true только если сайт реально на https и НЕ за прокси-терминатором Render
COOKIE_SECURE=

# ─── Заказы ───
FUNPAY_URL=https://funpay.com/users/16370618/
ORDER_DEDUP_MINUTES=10

# ─── Ограничение частоты запросов ───
RATE_LIMIT_PER_MIN=120
AUTH_RATE_LIMIT=30
