# ─────────────────────────────────────────────────────────────────────────────
#  Sprice Private — переменные окружения
#  Скопируй в .env для локальной разработки:  cp .env.example .env
#  На Render эти же переменные задаются в разделе Environment.
#  ВАЖНО: .env в репозиторий не коммитится (он в .gitignore).
# ─────────────────────────────────────────────────────────────────────────────

# ─── Сервер ───
# На Render PORT задаётся автоматически, вручную не трогать.
PORT=3000
# production включает secure-cookie и HSTS. Локально оставь пустым.
NODE_ENV=

# ─── База данных ───
# Если DATABASE_URL задан — используется Postgres, иначе встроенный SQLite (только локально).
# На Render: создай PostgreSQL и скопируй сюда Internal Database URL.
# Файловая система Render эфемерная — без Postgres данные будут теряться при каждом деплое.
DATABASE_URL=
# Локальный файл SQLite (используется только когда DATABASE_URL пуст)
SQLITE_PATH=./data/sprice.db
# Отключить SSL для Postgres (по умолчанию включается сам для не-localhost)
PGSSL=
PG_POOL_MAX=5

# ─── Секреты ───
# ОБЯЗАТЕЛЬНО смени в продакшене! Иначе коды подтверждения можно подделать.
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CODE_PEPPER=change-me-please-32-random-bytes

# ─── Почта (выбери ОДИН вариант) ───
# Вариант 1 — Resend (проще всего, 3000 писем/мес бесплатно, домен не обязателен)
RESEND_API_KEY=

# Вариант 2 — обычный SMTP (Gmail, Brevo, Mailgun, Яндекс, свой сервер)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Если не задано ни то, ни другое — включается DEV-режим:
# письма не уходят, код подтверждения печатается в логах сервера.

MAIL_FROM=Sprice Private <no-reply@sprice.example>
MAIL_REPLY_TO=
# Адрес сайта — подставляется в письмо и в ссылки
SITE_URL=http://localhost:3000

# ─── Поведение кодов и сессий ───
CODE_TTL_MINUTES=10
CODE_MAX_ATTEMPTS=5
RESEND_COOLDOWN_SEC=60
RESEND_MAX_PER_HOUR=5

# «Запомнить меня» — 30 дней; без галочки — 12 часов
SESSION_TTL_HOURS=720
SESSION_TTL_HOURS_SHORT=12
# true только если сайт реально на https и НЕ за прокси-терминатором Render
COOKIE_SECURE=

# ─── Заказы ───
FUNPAY_URL=https://funpay.com/users/16370618/
ORDER_DEDUP_MINUTES=10

# ─── Ограничение частоты запросов ───
RATE_LIMIT_PER_MIN=120
AUTH_RATE_LIMIT=30
